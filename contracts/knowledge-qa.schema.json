{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "normalization": {
      "type": "object",
      "properties": {
        "normalized_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "needs_clarification": {
          "type": "boolean"
        },
        "clarification_question": {
          "type": "string",
          "maxLength": 2000
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 15
        },
        "search_queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 2
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "maxItems": 8
        },
        "include_reviews": {
          "type": "boolean"
        },
        "latest_release": {
          "type": "boolean"
        },
        "visual_check": {
          "type": "boolean"
        },
        "recording_names": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "conversation_relation": {
          "enum": [
            "NEW",
            "FOLLOW_UP",
            "CORRECTION"
          ]
        },
        "request_parts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1
        },
        "confirmed_context": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "visual_targets": {
          "type": "array",
          "items": {
            "enum": [
              "ARTICLE_IMAGE",
              "VIDEO_FRAME",
              "USER_IMAGE"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": [
        "normalized_question",
        "needs_clarification",
        "clarification_question",
        "changes",
        "search_queries",
        "visual_check",
        "recording_names",
        "conversation_relation",
        "request_parts",
        "confirmed_context",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ANSWER",
            "INSUFFICIENT_EVIDENCE",
            "CLARIFY",
            "PARTIAL"
          ]
        },
        "clarification_question": {
          "type": "string",
          "maxLength": 2000
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 20
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "basis": {
                "enum": [
                  "SOURCE",
                  "INFERENCE",
                  "REVIEW_REPORT",
                  "VISUAL"
                ]
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "excerpt": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "evidence_id",
                    "excerpt"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "section": {
                "enum": [
                  "ANSWER",
                  "STEPS",
                  "DETAILS"
                ]
              }
            },
            "required": [
              "id",
              "text",
              "basis",
              "citations"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 12
        },
        "unresolved": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "procedure_complete": {
          "type": "boolean"
        },
        "illustrations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "required": [
        "status",
        "clarification_question",
        "claims",
        "limitations"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "REVISE",
            "INSUFFICIENT_EVIDENCE",
            "PARTIAL_PASS"
          ]
        },
        "addresses_question": {
          "type": "boolean"
        },
        "normalization_faithful": {
          "type": "boolean"
        },
        "premise_supported": {
          "type": "boolean"
        },
        "human_readable": {
          "type": "boolean"
        },
        "claim_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "maxLength": 20
              },
              "supported": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "claim_id",
              "supported",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 15
        },
        "retrieval_queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 2
        },
        "read_source_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "maxItems": 4
        },
        "evidence_coverage_sufficient": {
          "type": "boolean"
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "requested_scope_complete": {
          "type": "boolean"
        },
        "retrieval_keywords": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "illustration_checks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "maxLength": 20
              },
              "relevant": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "evidence_id",
              "relevant",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "decision",
        "addresses_question",
        "normalization_faithful",
        "premise_supported",
        "human_readable",
        "claim_checks",
        "feedback",
        "evidence_coverage_sufficient",
        "coverage_reason",
        "requested_scope_complete"
      ],
      "additionalProperties": false
    }
  }
}
